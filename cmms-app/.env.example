# Cadena de conexión a PostgreSQL. En Vercel + Neon/Supabase, usar la que provee el proveedor.
DATABASE_URL="postgresql://user:password@localhost:5432/cmms_dev?schema=public"

# Secreto de firma de sesión de NextAuth (Auth.js). Generar uno nuevo por entorno:
#   openssl rand -base64 32
AUTH_SECRET="reemplazar-con-un-secreto-generado"
